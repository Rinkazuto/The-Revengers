@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Welcome screen on top of everything when the app opens (wireframe 1) *@
@if (_showWelcome)
{
    <WelcomeScreen OnStart="CloseWelcome" />
}

<MudLayout>
    <MudMainContent Class="page-content">
        @* Small brand name at the top right (new wireframes: no top bar) *@
        <div class="brand-header">ReVolt</div>

        @Body
    </MudMainContent>

    @* Bottom bar: 4 main pages, where thumbs reach (Section 6) *@
    <nav class="bottom-bar">
        <NavLink href="" Match="NavLinkMatch.All" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
            <span>Bill</span>
        </NavLink>
        <NavLink href="solar" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.WbSunny" />
            <span>Solar</span>
        </NavLink>
        <NavLink href="cyclone" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.Cyclone" />
            <span>Cyclone</span>
        </NavLink>
        <NavLink href="readings" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
            <span>Readings</span>
        </NavLink>
    </nav>
</MudLayout>

@code {
        // ReVolt colours (logo SVGs in docs/logo + Integrator's readability check).
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2E7D32",                 // dark green: buttons with white text, active tab (readable: 4.5:1)
            Secondary = "#F7C61A",               // logo yellow: "See solar savings", highlights (always dark text on it) 
            SecondaryContrastText = "#0F3D24",   // dark text on the yellow buttons
            Tertiary = "#0F3D24",                // dark green: big result cards, Welcome screen
        }
    };
        // Shown once each time the app is opened (or refreshed); "Get started" hides it
    private bool _showWelcome = true;

    private void CloseWelcome() => _showWelcome = false;
}