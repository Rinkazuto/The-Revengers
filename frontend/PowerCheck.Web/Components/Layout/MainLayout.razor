@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">Power Check</MudText>
    </MudAppBar>

    <MudMainContent Class="page-content">
        @Body
    </MudMainContent>

    <MudAppBar Bottom="true" Fixed="true" Elevation="8" Color="Color.Surface" Class="bottom-bar">
        <NavLink href="" Match="NavLinkMatch.All" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
            <span>Bill</span>
        </NavLink>
        <NavLink href="solar" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.WbSunny" />
            <span>Solar</span>
        </NavLink>
        <NavLink href="readings" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
            <span>Readings</span>
        </NavLink>
    </MudAppBar>
</MudLayout>