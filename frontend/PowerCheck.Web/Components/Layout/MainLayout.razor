@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">ReVolt</MudText>
    </MudAppBar>

    <MudMainContent Class="page-content">
        @Body
    </MudMainContent>

    <MudAppBar Bottom="true" Fixed="true" Elevation="8" Color="Color.Surface" Class="bottom-bar">
        <NavLink href="" Match="NavLinkMatch.All" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
            <span>Bill</span>
        </NavLink>
        <NavLink href="solar" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.WbSunny" />
            <span>Solar</span>
        </NavLink>
        <NavLink href="readings" class="bottom-tab">
            <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
            <span>Readings</span>
        </NavLink>
    </MudAppBar>
</MudLayout>

@code {
    // ReVolt colours (decision log #7: green logo). Replace with the designer's exact green.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2E7D32",
            AppbarBackground = "#2E7D32",
        }
    };
}