@page "/solar"
@using System.Globalization
@inject IPowerCheckApi Api
@inject CalculationState State

<PageTitle>Solar: ReVolt</PageTitle>

<MudText Typo="Typo.h5">Solar check</MudText>

@if (State.MonthlyKwh is null)
{
    @* ---------- No bill yet: the user opened the Solar tab first ---------- *@
    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Class="mb-4">
            First, enter the units (kWh) from your CEB bill on the Bill page.
            We'll use them to compare your bill with and without solar.
        </MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="tap-48">
            Go to Bill
        </MudButton>
    </MudPaper>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4">
        @Kwh(State.MonthlyKwh.Value) kWh a month · estimate
    </MudText>

    @* ---------- System size (light green row, at the top) ---------- *@
    <div class="card-tint mb-3 d-flex justify-space-between align-center" style="padding-top: 8px; padding-bottom: 8px;">
        <MudText Typo="Typo.body1">System size</MudText>
        <MudSelect T="decimal" Value="ShownSize" ValueChanged="OnSizeChangedAsync" Disabled="_loading"
                   Variant="Variant.Text" Dense="true" Underline="false" AnchorOrigin="Origin.BottomCenter"
                   Style="max-width: 100px; margin-left: 16px; font-weight: 600;">
            @foreach (var size in Sizes)
            {
                <MudSelectItem T="decimal" Value="@size">@Kwh(size) kWp</MudSelectItem>
            }
        </MudSelect>
    </div>
    @if (_sizeChoice == 0 && _result is not null)
    {
        <MudText Typo="Typo.caption" Class="d-block mb-3" Style="margin-top: -8px;">
            Picked for your usage. Change it if you like.
        </MudText>
    }

    @if (_loading)
    {
        <div class="d-flex justify-center my-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="tap-48" OnClick="EstimateAsync">
            Try again
        </MudButton>
    }
    else if (_result is not null)
    {
        @* ---------- Today vs With solar, side by side ---------- *@
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6">
                <div class="card-tint" style="height: 100%; padding: 12px;">
                    <MudText Typo="Typo.body2">Today</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; white-space: nowrap;">Rs @Rs(_result.WithoutSolar.MonthlyBillRs)</MudText>
                </div>
            </MudItem>
            <MudItem xs="6">
                <div style="height: 100%; border: 2px solid var(--mud-palette-primary); border-radius: 16px; padding: 12px;">
                    <MudText Typo="Typo.body2">With solar</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; white-space: nowrap;">Rs @Rs(_result.WithSolar.MonthlyBillRs)</MudText>
                    <MudText Typo="Typo.caption">Tariff 150A</MudText>
                </div>
            </MudItem>
        </MudGrid>

        @* ---------- Savings and payback (dark green card, yellow amount) ---------- *@
        <div class="card-dark mb-4">
            @if (_result.MonthlySavingsRs > 0)
            {
                <MudText Typo="Typo.h5" Style="font-weight: 700;">
                    Save <span class="highlight">Rs @Rs(_result.MonthlySavingsRs)</span> a month
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">No monthly saving at this usage.</MudText>
            }

            @if (_result.PaybackYears is { } years)
            {
                <MudText Typo="Typo.body1" Class="mt-1">Money back in about @years.ToString("0.#", Inv) years</MudText>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="mt-1">Solar doesn't pay back at this usage.</MudText>
            }
        </div>

        @* ---------- Export credit and cost ---------- *@
        <div class="d-flex justify-space-between mb-1">
            <MudText Typo="Typo.body2">Export credit (separate)</MudText>
            <MudText Typo="Typo.body2"><b>Rs @Rs(_result.WithSolar.ExportCreditRs)</b></MudText>
        </div>
        <MudText Typo="Typo.caption" Class="d-block mb-3">
            A month, for extra solar sent to CEB. Not taken off your bill or counted in your savings.
        </MudText>

        <div class="d-flex justify-space-between mb-1">
            <MudText Typo="Typo.body2">Cost after grant and fee</MudText>
            <MudText Typo="Typo.body2"><b>Rs @Rs(_result.InstallCostRs)</b></MudText>
        </div>
        <MudText Typo="Typo.caption" Class="d-block mb-4">
            After the 25% grant, incl. Rs 2,000 fee. CEB estimate.
        </MudText>

        @* ---------- Assumptions (green link, open by default) ---------- *@
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="px-0 mb-1" Style="font-weight: 600; text-transform: none;"
                   EndIcon="@(_showAssumptions ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
                   OnClick="() => _showAssumptions = !_showAssumptions">
            Assumptions
        </MudButton>
        @if (_showAssumptions)
        {
            @foreach (var assumption in _result.Assumptions)
            {
                <MudText Typo="Typo.body2" Class="mb-2">• @assumption</MudText>
            }
            <MudText Typo="Typo.caption" Class="d-block mb-3">Source: @_result.Source</MudText>
        }

        @* ---------- How to apply ---------- *@
        <MudButton Href="@SchemeLeafletUrl" Target="_blank"
                   Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                   EndIcon="@Icons.Material.Filled.OpenInNew" Class="tap-48 mb-4">
            How to apply (CEB leaflet)
        </MudButton>
    }
}

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // Official CEB scheme leaflet (link from data/sources/README.md)
    private const string SchemeLeafletUrl =
        "https://ceb.mu/docs/files/files/application%20schemes/Information%20Leaflet%20on%20Household%20Rooftop%20Solar%20Photovoltaic%20Scheme.pdf";

    // CEB price-guide sizes from the agreed API contract (no endpoint lists them).
    private static readonly decimal[] Sizes = [1.5m, 2m, 2.5m, 3m, 3.5m, 4m, 4.5m, 5m, 6m, 7.5m, 10m, 15m];

    private decimal _sizeChoice;   // 0 = let the backend recommend a size
    private SolarResponse? _result;
    private bool _loading;
    private string? _error;
    private bool _showAssumptions = true;

    // The size shown in the picker: the user's choice, or the size the backend recommended
    private decimal ShownSize => _sizeChoice != 0 ? _sizeChoice : _result?.SystemSizeKwp ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Only estimate if the user calculated a bill first
        if (State.MonthlyKwh is not null)
        {
            await EstimateAsync();
        }
    }

    private async Task OnSizeChangedAsync(decimal size)
    {
        _sizeChoice = size;
        await EstimateAsync();
    }

    private async Task EstimateAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            decimal? size = _sizeChoice == 0 ? null : _sizeChoice;
            _result = await Api.EstimateSolarAsync(new SolarRequest(State.MonthlyKwh!.Value, size, State.TariffCode));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // Money always with 2 decimals (contract rule), e.g. 1,216.75
    private static string Rs(decimal value) => value.ToString("N2", Inv);

    private static string Kwh(decimal value) => value.ToString("0.##", Inv);
}