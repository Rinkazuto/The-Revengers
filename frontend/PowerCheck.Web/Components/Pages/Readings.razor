@page "/readings"
@using System.Globalization
@inject IPowerCheckApi Api
@inject CalculationState State
@inject ISnackbar Snackbar

<PageTitle>Readings: ReVolt</PageTitle>

<MudText Typo="Typo.h5">Your readings</MudText>
<MudText Typo="Typo.body2" Class="mb-4">Last 6 months</MudText>

@if (_loading)
{
    <div class="d-flex justify-center my-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="tap-48 mb-4" OnClick="LoadAsync">
        Try again
    </MudButton>
}
else if (_readings.Count > 0)
{
    @* ---------- Bar chart (light green card): last 6 months, oldest on the left, newest bar in yellow ---------- *@
    <div class="card-tint mb-3">
        <div class="bar-chart">
            @foreach (var reading in LastSix)
            {
                <div class="bar-col">
                    <div class="bar" style="@BarStyle(reading)"></div>
                    <span class="bar-label">@ShortMonth(reading.Month)</span>
                </div>
            }
        </div>
    </div>

    @* ---------- Trend pill vs the previous saved month ---------- *@
    @if (TrendText is not null)
    {
        <div class="d-flex align-center mb-4"
             style="background: @TrendBackground; border-radius: 12px; padding: 8px 12px;">
            <MudIcon Icon="@TrendIcon" Size="Size.Small" Class="mr-2" />
            <MudText Typo="Typo.body2" Style="font-weight: 600;">@TrendText</MudText>
        </div>
    }

    @* ---------- List: newest first ---------- *@
    <div class="mb-4">
        @foreach (var reading in _readings.AsEnumerable().Reverse())
        {
            <div class="reading-row d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.body1">@LongMonth(reading.Month)</MudText>
                    <MudText Typo="Typo.caption">Bill about Rs @Rs(reading.BillRs)</MudText>
                </div>
                <MudText Typo="Typo.body1"><b>@Kwh(reading.Kwh)</b> kWh</MudText>
            </div>
            <MudDivider />
        }
    </div>
}

@* ---------- Add reading: big green button, or the form when open ---------- *@
@if (!_adding)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
               Class="tap-48" Style="border-radius: 12px; font-weight: 700; text-transform: none;" OnClick="OpenForm">
        Add reading
    </MudButton>
    @if (!_loading && _error is null && _readings.Count == 0)
    {
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Add your first reading</MudText>
    }
}
else
{
    <div class="card-tint mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">Add a reading</MudText>

        <MudSelect T="string" @bind-Value="_newMonth" Label="Month"
                   Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-4">
            @foreach (var month in RecentMonths)
            {
                <MudSelectItem T="string" Value="@month">@LongMonth(month)</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="decimal?" @bind-Value="_newKwh"
                         Label="Units used (from your CEB bill)"
                         Adornment="Adornment.End" AdornmentText="kWh"
                         HideSpinButtons="true" InputMode="InputMode.numeric"
                         Variant="Variant.Outlined" Class="mb-2" />

        <MudText Typo="Typo.caption" Class="d-block mb-4">Saving a month again replaces its old reading.</MudText>

        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_formError</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Class="tap-48 mb-2" Style="border-radius: 12px; text-transform: none;" Disabled="_saving" OnClick="SaveAsync">
            @(_saving ? "Saving…" : "Save reading")
        </MudButton>
        <MudButton Variant="Variant.Text" FullWidth="true" Class="tap-48" Style="text-transform: none;" Disabled="_saving" OnClick="CloseForm">
            Cancel
        </MudButton>
    </div>
}

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private const double MaxBarPx = 110;

    // Design colours: soft green bars, newest bar in the logo yellow
    private const string BarGreen = "#8FC89A";
    private const string BarNewest = "var(--mud-palette-secondary)";

    private List<ReadingDto> _readings = new();   // oldest → newest (as the API sends them)
    private bool _loading;
    private string? _error;

    private bool _adding;
    private bool _saving;
    private string _newMonth = ThisMonth;
    private decimal? _newKwh;
    private string? _formError;

    private List<ReadingDto> LastSix => _readings.TakeLast(6).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Api.GetReadingsAsync();
            _readings = response.Readings;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenForm()
    {
        _adding = true;
        _formError = null;
        _newMonth = ThisMonth;
        _newKwh = State.MonthlyKwh;   // pre-fill with the kWh from the Bill page, if any
    }

    private void CloseForm() => _adding = false;

    private async Task SaveAsync()
    {
        _formError = null;
        if (_newKwh is null) { _formError = "Enter the units (kWh) from your CEB bill."; return; }
        if (_newKwh < 0 || _newKwh > 5000) { _formError = "Enter a number between 0 and 5000 kWh."; return; }

        _saving = true;
        try
        {
            await Api.SaveReadingAsync(new ReadingRequest(_newMonth, _newKwh.Value));
            Snackbar.Add($"Saved your reading for {LongMonth(_newMonth)}.", Severity.Success);
            _adding = false;
            await LoadAsync();   // refresh the chart, trend and list
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // ---------- Trend: compare the last two saved months ----------
    private string? TrendText
    {
        get
        {
            if (_readings.Count < 2) return null;
            var previous = _readings[^2];
            var last = _readings[^1];

            // "vs last month" when the two months follow each other, otherwise name the month
            var isPreviousMonth = ParseMonth(previous.Month).AddMonths(1) == ParseMonth(last.Month);
            var vs = isPreviousMonth ? "vs last month" : $"vs {ShortMonth(previous.Month)} {previous.Month[..4]}";

            if (last.Kwh == previous.Kwh) return isPreviousMonth ? "Same as last month" : $"Same as {ShortMonth(previous.Month)} {previous.Month[..4]}";
            var direction = last.Kwh > previous.Kwh ? "Up" : "Down";
            if (previous.Kwh == 0) return $"{direction} {vs}";

            var percent = Math.Abs((last.Kwh - previous.Kwh) / previous.Kwh * 100);
            return $"{direction} {percent.ToString("0", Inv)}% {vs}";
        }
    }

    private bool UsageUp => _readings.Count >= 2 && _readings[^1].Kwh > _readings[^2].Kwh;
    private bool UsageDown => _readings.Count >= 2 && _readings[^1].Kwh < _readings[^2].Kwh;

    private string TrendIcon =>
        UsageUp ? Icons.Material.Filled.TrendingUp
        : UsageDown ? Icons.Material.Filled.TrendingDown
        : Icons.Material.Filled.TrendingFlat;

    // Using more is a warning (light yellow pill), using less is good news (light green pill)
    private string TrendBackground => UsageUp ? "#FFF3C4" : UsageDown ? "#EEF6EF" : "#F2F2F2";

    // ---------- Chart: bar height relative to the biggest of the 6 months; newest bar in yellow ----------
    private string BarStyle(ReadingDto reading)
    {
        var six = LastSix;
        var max = six.Max(r => r.Kwh);
        var px = max == 0 ? 4 : Math.Max(4, (double)(reading.Kwh / max) * MaxBarPx);
        var colour = reading == six[^1] ? BarNewest : BarGreen;
        return $"height: {px.ToString("0", Inv)}px; background: {colour};";
    }

    // ---------- Months ----------
    private static string ThisMonth => DateTime.Now.ToString("yyyy-MM", Inv);

    // This month and the 11 before it (the API refuses future months)
    private static IEnumerable<string> RecentMonths =>
        Enumerable.Range(0, 12).Select(i => DateTime.Now.AddMonths(-i).ToString("yyyy-MM", Inv));

    private static DateTime ParseMonth(string month) =>
        DateTime.ParseExact(month, "yyyy-MM", Inv);

    private static string ShortMonth(string month) => ParseMonth(month).ToString("MMM", Inv);        // "Oct"
    private static string LongMonth(string month) => ParseMonth(month).ToString("MMM yyyy", Inv);    // "Oct 2026"

    // ---------- Numbers ----------
    private static string Rs(decimal value) => value.ToString("N2", Inv);
    private static string Kwh(decimal value) => value.ToString("0.##", Inv);
}